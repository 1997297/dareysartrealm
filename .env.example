# DAREY'S ARTREALM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit secrets to version control.

# Supabase Public Configuration (Browser Client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Configuration (Administrative functions, seed tasks, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public Application URL (used for auth callbacks and password recovery redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
